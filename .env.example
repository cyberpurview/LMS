NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring SMTP and installing the verified email-change templates.
AUTH_EMAIL_CHANGE_ENABLED=false
# Optional: needed only for server-side administrator invitations. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Notification email delivery (server-only). Use a verified Resend sender.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
CONTACT_EMAIL_TO=
APP_URL=
CRON_SECRET=
# AI course generation: server-only, with a configurable model for future upgrades.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_WORKER_URL=http://localhost:3000
AI_DAILY_REQUEST_LIMIT=100
